bool _$shellConsistencyCheck() {
  bool visit(GeneratedRoute route) {
    final page = route.page;
    if (page != null && _$appliedShellsByPage[page] != route.shell) {
      return false;
    }
    return route.routes.every(visit);
  }
  return {{ routes_variable }}.every(visit);
}
