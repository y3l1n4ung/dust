String testRouteLocation(TestRoutePath route) => route.location;

TestRoutePath parseTestRoute(Uri uri) {
  final segments = uri.pathSegments;

  if (segments.isEmpty) {
    final route = TestHomeRoute();
    return withGeneratedRouteUriExtras(route, uri, const <String>{});
  }
  if (segments.length == 1 && segments[0] == '404') {
    final route = TestNotFoundRoute(path: uri.queryParameters['path'] ?? '');
    return withGeneratedRouteUriExtras(route, uri, const {'path'});
  }
  if (segments.length == 1 && segments[0] == 'picker') {
    final route = TestPickerRoute();
    return withGeneratedRouteUriExtras(route, uri, const <String>{});
  }
  return _$notFoundRoute(uri);
}

TestRoutePath _$notFoundRoute(Uri uri) => TestNotFoundRoute(path: uri.toString());


