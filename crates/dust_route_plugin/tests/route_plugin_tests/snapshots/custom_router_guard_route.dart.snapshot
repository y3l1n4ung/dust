BenchmarkRoutePath parseBenchmarkRoute(Uri uri) {
  final segments = uri.pathSegments;

  if (segments.isEmpty) {
    final route = BenchmarkDashboardRoute();
    return withGeneratedRouteUriExtras(route, uri, const <String>{});
