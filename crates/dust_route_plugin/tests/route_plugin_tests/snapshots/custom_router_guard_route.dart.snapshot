const Map<Type, Type?> _$appliedShellsByPage = {
  DashboardPage: null,
  NotFoundPage: null,
};

Page<dynamic> buildBenchmarkRoutePage(
  BenchmarkRoutePath route,
  LocalKey key,
  PopInvokedWithResultCallback<Object?> onPopInvoked,
