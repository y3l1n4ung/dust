}

/// Typed route data for `ReportRoute`.
final class ReportRoute extends TestRoute<void> {
  const ReportRoute({required this.orgId, required this.projectId, required this.reportId});

  final int orgId;
  final int projectId;
  final int reportId;

  @override
  String get location {
    return generatedRoutePath(
      [
      'orgs',
      orgId.toString(),
      'projects',
      projectId.toString(),
      'reports',
      reportId.toString(),
    ],
      uriExtras: generatedRouteUriExtrasOf(this),
    );
  }
}

String testRouteLocation(TestRoute route) => route.location;

TestRoute parseTestRoute(Uri uri) {
  final segments = uri.pathSegments;

  if (segments.length == 1 && segments[0] == '404') {
    final route = NotFoundRoute(path: uri.queryParameters['path'] ?? '');
    return withGeneratedRouteUriExtras(route, uri, const {'path'});
  }
  if (
    segments.length == 6 &&
    segments[0] == 'orgs' &&
    segments[2] == 'projects' &&
    segments[4] == 'reports'
  ) {
    final orgId = int.tryParse(segments[1]);
    final projectId = int.tryParse(segments[3]);
    final reportId = int.tryParse(segments[5]);
    if (orgId == null) {
      return _$notFoundRoute(uri);
    }
    if (projectId == null) {
      return _$notFoundRoute(uri);
    }
    if (reportId == null) {
      return _$notFoundRoute(uri);
    }
    final route = ReportRoute(
      orgId: orgId,
      projectId: projectId,
      reportId: reportId,
    );
    return withGeneratedRouteUriExtras(route, uri, const <String>{});
  }
  return _$notFoundRoute(uri);
}

TestRoute _$notFoundRoute(Uri uri) => NotFoundRoute(path: uri.toString());


