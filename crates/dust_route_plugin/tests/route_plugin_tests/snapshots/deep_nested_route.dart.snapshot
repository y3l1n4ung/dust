  /// (login, invite, forbidden, checkout, notFound).
  bool get requiresAuth => true;
}

/// Typed route data for `NotFoundRoute`.
final class NotFoundRoute extends TestRoute<void> {
  const NotFoundRoute({this.path = ''});

  final String path;

  @override
