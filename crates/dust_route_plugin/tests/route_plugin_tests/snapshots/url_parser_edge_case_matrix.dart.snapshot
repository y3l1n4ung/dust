  final text = Uri(
    pathSegments: segments,
    queryParameters: query.isEmpty ? null : query,
    fragment: uriExtras?.fragment.isEmpty ?? true ? null : uriExtras!.fragment,
  ).toString();
  if (text.isEmpty) return '/';
  return text.startsWith('/') ? text : '/$text';
}

TestRoutePath parseTestRoute(Uri uri) {
  final segments = uri.pathSegments;

  if (segments.isEmpty) {
    final route = TestHomeRoute();
    return _$withRouteUriExtras(route, uri, const <String>{});
  }
  if (segments.length == 1 && segments[0] == '404') {
    final route = TestNotFoundRoute(path: uri.queryParameters['path'] ?? '');
    return _$withRouteUriExtras(route, uri, const {'path'});
  }
  if (segments.length == 3 && segments[0] == 'invite') {
    final code = segments[1];
    final active = _$parseBool(segments[2]);
    if (active == null) {
      return _$notFoundRoute(uri);
    }
    final route = TestInvitePreviewRoute(
      code: code,
      active: active,
      score: double.tryParse(uri.queryParameters['score'] ?? '') ?? 0.0,
    );
    return _$withRouteUriExtras(route, uri, const <String>{'score'});
  }
  if (segments.length == 2 && segments[0] == 'products') {
    final productId = int.tryParse(segments[1]);
    if (productId == null) {
      return _$notFoundRoute(uri);
    }
    final route = TestProductDetailRoute(
      productId: productId,
      ref: uri.queryParameters['ref'],
      preview: _$parseBool(uri.queryParameters['preview']) ?? false,
    );
    return _$withRouteUriExtras(route, uri, const <String>{'ref', 'preview'});
  }
  if (segments.length == 1 && segments[0] == 'search') {
    final route = TestSearchRoute(
      query: uri.queryParameters['query'],
      page: int.tryParse(uri.queryParameters['page'] ?? '') ?? 1,
      minRating: double.tryParse(uri.queryParameters['minRating'] ?? ''),
      inStock: _$parseBool(uri.queryParameters['inStock']),
    );
    return _$withRouteUriExtras(route, uri, const <String>{'query', 'page', 'minRating', 'inStock'});
  }
  return _$notFoundRoute(uri);
}

TestRoutePath _$notFoundRoute(Uri uri) => TestNotFoundRoute(path: uri.toString());

bool? _$parseBool(String? value) {
  return switch (value) {
    'true' || '1' => true,
    'false' || '0' => false,
    null || '' => null,
    _ => null,
  };
}


