  }
  if (segments.length == 1 && segments[0] == 'filters') {
    final tab = generatedRouteParseEnum(RouteTab.values, uri.queryParameters['tab']);
    final from = DateTime.tryParse(uri.queryParameters['from'] ?? '');
    final redirect = uri.queryParameters.containsKey('redirect') ? Uri.tryParse(uri.queryParameters['redirect'] ?? '') : null;
    final tags = uri.queryParametersAll['tags'] ?? const <String>[];
    final ids = uri.queryParametersAll.containsKey('ids') ? generatedRouteParseIntList(uri.queryParametersAll['ids']) : null;
    if (tab == null) {
      return _$notFoundRoute(uri);
    }
    if (from == null) {
      return _$notFoundRoute(uri);
    }
    if (uri.queryParameters.containsKey('redirect') && redirect == null) {
      return _$notFoundRoute(uri);
    }
    if (uri.queryParametersAll.containsKey('ids') && ids == null) {
      return _$notFoundRoute(uri);
    }
    final route = TestFiltersRoute(
      tab: tab,
      from: from,
      redirect: redirect,
      tags: tags,
      ids: ids,
    );
    return withGeneratedRouteUriExtras(route, uri, const <String>{'tab', 'from', 'redirect', 'tags', 'ids'});
  }
  if (segments.length == 3 && segments[0] == 'invite') {
    final code = segments[1];
    final active = generatedRouteParseBool(segments[2]);
    final score = uri.queryParameters.containsKey('score') ? double.tryParse(uri.queryParameters['score'] ?? '') : 0.0;
    if (active == null) {
      return _$notFoundRoute(uri);
    }
    if (score == null) {
      return _$notFoundRoute(uri);
    }
    final route = TestInvitePreviewRoute(
      code: code,
      active: active,
      score: score,
    );
    return withGeneratedRouteUriExtras(route, uri, const <String>{'score'});
  }
  if (segments.length == 2 && segments[0] == 'products') {
    final productId = int.tryParse(segments[1]);
    final ref = uri.queryParameters['ref'];
    final preview = uri.queryParameters.containsKey('preview') ? generatedRouteParseBool(uri.queryParameters['preview']) : false;
    if (productId == null) {
      return _$notFoundRoute(uri);
    }
    if (preview == null) {
      return _$notFoundRoute(uri);
    }
    final route = TestProductDetailRoute(
      productId: productId,
      ref: ref,
      preview: preview,
    );
    return withGeneratedRouteUriExtras(route, uri, const <String>{'ref', 'preview'});
  }
  if (segments.length == 1 && segments[0] == 'search') {
    final query = uri.queryParameters['query'];
    final page = uri.queryParameters.containsKey('page') ? int.tryParse(uri.queryParameters['page'] ?? '') : 1;
    final minRating = uri.queryParameters.containsKey('minRating') ? double.tryParse(uri.queryParameters['minRating'] ?? '') : null;
    final inStock = uri.queryParameters.containsKey('inStock') ? generatedRouteParseBool(uri.queryParameters['inStock']) : null;
    if (page == null) {
      return _$notFoundRoute(uri);
    }
    if (uri.queryParameters.containsKey('minRating') && minRating == null) {
      return _$notFoundRoute(uri);
    }
    if (uri.queryParameters.containsKey('inStock') && inStock == null) {
      return _$notFoundRoute(uri);
    }
    final route = TestSearchRoute(
      query: query,
      page: page,
      minRating: minRating,
      inStock: inStock,
    );
    return withGeneratedRouteUriExtras(route, uri, const <String>{'query', 'page', 'minRating', 'inStock'});
