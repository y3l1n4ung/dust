Page<dynamic> buildTestRoutePage(
  TestRoutePath route,
  LocalKey key,
  PopInvokedWithResultCallback<Object?> onPopInvoked,
) {
  assert(
    generatedRouteShellsMatch($testRoutes, _$appliedShellsByPage),
    'Shell mismatch between \$testRoutes and buildTestRoutePage',
  );
  return switch (route) {
    TestNotFoundRoute(path: final path) => generatedPage(
      key: key,
      location: route.location,
      name: 'notFound',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: NotFoundPage(path: path),
    ),
    TestAdminRoute() => generatedPage(
      key: key,
      location: route.location,
      name: 'admin',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: const AdminPage(),
    ),
    TestDashboardRoute() => generatedPage(
      key: key,
      location: route.location,
      name: 'dashboard',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: AppShell(child: const DashboardPage()),
    ),
    TestDashboardOrdersRoute() => generatedPage(
      key: key,
      location: route.location,
      name: 'dashboardOrders',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: AppShell(child: const DashboardOrdersPage()),
    ),
    TestInviteRoute(code: final code, team: final team) => generatedPage(
      key: key,
      location: route.location,
      name: 'invite',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: InvitePage(code: code, team: team),
    ),
    TestOrgProjectRoute(
      orgId: final orgId,
      projectId: final projectId,
      tab: final tab,
    ) => generatedPage(
      key: key,
      location: route.location,
      name: 'orgProject',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: OrgProjectPage(orgId: orgId, projectId: projectId, tab: tab),
    ),
    TestProductPickerRoute() => generatedPage(
      key: key,
      location: route.location,
      name: 'productPicker',
      onPopInvoked: onPopInvoked,
      transition: BottomToTopPageTransitionsBuilder(),
      fullscreenDialog: true,
      maintainState: true,
      child: const ProductPickerPage(),
    ),
    TestProductSearchRoute(
      query: final query,
      page: final page,
      showArchived: final showArchived,
    ) => generatedPage(
      key: key,
      location: route.location,
