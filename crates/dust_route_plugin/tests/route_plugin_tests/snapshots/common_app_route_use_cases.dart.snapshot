const Map<Type, Type?> _$appliedShellsByPage = {
  NotFoundPage: null,
  AdminPage: null,
  DashboardPage: AppShell,
  DashboardOrdersPage: AppShell,
  InvitePage: null,
  OrgProjectPage: null,
  ProductPickerPage: null,
  ProductSearchPage: null,
  SetupPage: SetupShell,
  SetupConnectPage: SetupShell,
