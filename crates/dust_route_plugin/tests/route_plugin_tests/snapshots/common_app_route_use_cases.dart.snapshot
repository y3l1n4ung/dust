bool testRouteRequiresAuth(TestRoutePath route) => route.requiresAuth;

String? testRouteBranch(TestRoutePath route) {
  return switch (route) {
    TestDashboardRoute() => 'mainTabs',
    TestDashboardOrdersRoute() => 'mainTabs',
    _ => null,
  };
}

