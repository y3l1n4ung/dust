}

final class TestRoutesNavigator {
  const TestRoutesNavigator(this._router);

  final RouterController<TestRoute> _router;

  TestRouteAction<void> notFound({String path = ''}) =>
      TestRouteAction(_router, NotFoundRoute(path: path));

  TestRouteAction<void> admin() => TestRouteAction(_router, AdminRoute());

  TestRouteAction<void> dashboard() =>
      TestRouteAction(_router, DashboardRoute());

  TestRouteAction<void> dashboardOrders() =>
      TestRouteAction(_router, DashboardOrdersRoute());

  TestRouteAction<void> invite({required String code, String? team}) =>
      TestRouteAction(_router, InviteRoute(code: code, team: team));

  TestRouteAction<void> orgProject({required String orgId, required int projectId, String? tab}) =>
      TestRouteAction(_router, OrgProjectRoute(orgId: orgId, projectId: projectId, tab: tab));

  TestRouteAction<int> productPicker() =>
      TestRouteAction(_router, ProductPickerRoute());

  TestRouteAction<void> productSearch({String? query, int page = 1, bool showArchived = false}) =>
      TestRouteAction(_router, ProductSearchRoute(query: query, page: page, showArchived: showArchived));

  TestRouteAction<void> setup() => TestRouteAction(_router, SetupRoute());

  TestRouteAction<void> setupConnect() =>
      TestRouteAction(_router, SetupConnectRoute());

  bool pop<R>([R? result]) => _router.pop<R>(result);
}

final class TestRouteAction<R> {
  const TestRouteAction(this._router, this.route);

  final RouterController<TestRoute> _router;
  final TestRoute<R> route;

  void go() => _router.go(route);
  Future<R?> push() => _router.push<R>(route);
  void replace() => _router.replace(route);
}


