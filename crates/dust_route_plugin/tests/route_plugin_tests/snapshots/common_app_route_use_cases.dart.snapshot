  return switch (route) {
    TestNotFoundRoute(path: _) => const RouteDebugInfo(name: 'notFound', shell: null, branch: null),
    TestAdminRoute() => const RouteDebugInfo(name: 'admin', shell: null, branch: null),
    TestDashboardRoute() => const RouteDebugInfo(name: 'dashboard', shell: 'AppShell', branch: 'mainTabs'),
    TestDashboardOrdersRoute() => const RouteDebugInfo(name: 'dashboardOrders', shell: 'AppShell', branch: 'mainTabs'),
    TestInviteRoute(code: _, team: _) => const RouteDebugInfo(name: 'invite', shell: null, branch: null),
    TestOrgProjectRoute(orgId: _, projectId: _, tab: _) => const RouteDebugInfo(name: 'orgProject', shell: null, branch: null),
    TestProductPickerRoute() => const RouteDebugInfo(name: 'productPicker', shell: null, branch: null),
    TestProductSearchRoute(query: _, page: _, showArchived: _) => const RouteDebugInfo(name: 'productSearch', shell: null, branch: null),
    TestSetupRoute() => const RouteDebugInfo(name: 'setup', shell: 'SetupShell', branch: null),
    TestSetupConnectRoute() => const RouteDebugInfo(name: 'setupConnect', shell: 'SetupShell', branch: null),
  };
}

List<Object> testRouteGuards(
  TestRoutePath route,
  Object router,
) {
  return switch (route) {
    TestAdminRoute() => [AdminGuard()],
    _ => const [],
