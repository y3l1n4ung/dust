    ],
    SetupConnectRoute() => [
      const SetupRoute(),
      route,
    ],
  };
}

AppRoutePath parseAppRoute(Uri uri) {
  final segments = uri.pathSegments;

  if (segments.length == 1 && segments[0] == '404') {
    final route = NotFoundRoute(path: uri.queryParameters['path'] ?? '');
    return _withRouteUriExtras(route, uri, const {'path'});
  }
  if (segments.length == 1 && segments[0] == 'admin') {
    final route = AdminRoute();
    return _withRouteUriExtras(route, uri, const <String>{});
  }
  if (segments.length == 1 && segments[0] == 'dashboard') {
    final route = DashboardRoute();
    return _withRouteUriExtras(route, uri, const <String>{});
  }
  if (
    segments.length == 2 &&
    segments[0] == 'dashboard' &&
    segments[1] == 'orders'
  ) {
    final route = DashboardOrdersRoute();
    return _withRouteUriExtras(route, uri, const <String>{});
  }
  if (segments.length == 2 && segments[0] == 'invite') {
    final code = segments[1];
    final route = InviteRoute(code: code, team: uri.queryParameters['team']);
    return _withRouteUriExtras(route, uri, const <String>{'team'});
  }
  if (segments.length == 4 && segments[0] == 'orgs' && segments[2] == 'projects') {
    final orgId = segments[1];
    final projectId = int.tryParse(segments[3]);
    if (projectId == null) {
      return _notFoundRoute(uri);
    }
    final route = OrgProjectRoute(
      orgId: orgId,
      projectId: projectId,
      tab: uri.queryParameters['tab'],
    );
    return _withRouteUriExtras(route, uri, const <String>{'tab'});
  }
  if (segments.length == 1 && segments[0] == 'product-picker') {
    final route = ProductPickerRoute();
    return _withRouteUriExtras(route, uri, const <String>{});
  }
  if (segments.length == 1 && segments[0] == 'products') {
    final route = ProductSearchRoute(
      query: uri.queryParameters['query'],
      page: int.tryParse(uri.queryParameters['page'] ?? '') ?? 1,
      showArchived: _parseBool(uri.queryParameters['showArchived']) ?? false,
    );
    return _withRouteUriExtras(route, uri, const <String>{'query', 'page', 'showArchived'});
  }
  if (segments.length == 1 && segments[0] == 'setup') {
    final route = SetupRoute();
    return _withRouteUriExtras(route, uri, const <String>{});
  }
  if (segments.length == 2 && segments[0] == 'setup' && segments[1] == 'connect') {
    final route = SetupConnectRoute();
    return _withRouteUriExtras(route, uri, const <String>{});
  }
  return _notFoundRoute(uri);
}

AppRoutePath _notFoundRoute(Uri uri) => NotFoundRoute(path: uri.toString());

bool? _parseBool(String? value) {
  return switch (value) {
    'true' || '1' => true,
    'false' || '0' => false,
    null || '' => null,
    _ => null,
  };
}

const Map<Type, Type?> _kAppliedShellsByPage = {
  NotFoundPage: null,
  AdminPage: null,
  DashboardPage: AppShell,
  DashboardOrdersPage: AppShell,
  InvitePage: null,
  OrgProjectPage: null,
  ProductPickerPage: null,
  ProductSearchPage: null,
  SetupPage: SetupShell,
  SetupConnectPage: SetupShell,
};

bool _shellConsistencyCheck() {
  bool visit(GeneratedRoute route) {
    final page = route.page;
    if (page != null && _kAppliedShellsByPage[page] != route.shell) {
      return false;
    }
    return route.routes.every(visit);
  }
  return $appRoutes.every(visit);
}

Page<dynamic> buildAppRoutePage(
  AppRoutePath route,
  LocalKey key,
  PopInvokedWithResultCallback<Object?> onPopInvoked,
) {
  assert(
    _shellConsistencyCheck(),
    'Shell mismatch between \$appRoutes and buildAppRoutePage',
  );
  return switch (route) {
    NotFoundRoute(path: final path) => generatedPage(
      key: key,
      location: route.location,
      name: 'notFound',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: NotFoundPage(path: path),
    ),
    AdminRoute() => generatedPage(
      key: key,
      location: route.location,
      name: 'admin',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: const AdminPage(),
    ),
    DashboardRoute() => generatedPage(
      key: key,
      location: route.location,
      name: 'dashboard',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: AppShell(child: const DashboardPage()),
    ),
    DashboardOrdersRoute() => generatedPage(
      key: key,
      location: route.location,
      name: 'dashboardOrders',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: AppShell(child: const DashboardOrdersPage()),
    ),
    InviteRoute(code: final code, team: final team) => generatedPage(
      key: key,
      location: route.location,
      name: 'invite',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: InvitePage(code: code, team: team),
    ),
    OrgProjectRoute(
      orgId: final orgId,
      projectId: final projectId,
      tab: final tab,
    ) => generatedPage(
      key: key,
      location: route.location,
      name: 'orgProject',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: OrgProjectPage(orgId: orgId, projectId: projectId, tab: tab),
    ),
    ProductPickerRoute() => generatedPage(
      key: key,
      location: route.location,
      name: 'productPicker',
      onPopInvoked: onPopInvoked,
      transition: BottomToTopPageTransitionsBuilder(),
      fullscreenDialog: true,
      maintainState: true,
      child: const ProductPickerPage(),
    ),
    ProductSearchRoute(
      query: final query,
      page: final page,
      showArchived: final showArchived,
    ) => generatedPage(
      key: key,
      location: route.location,
      name: 'productSearch',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: ProductSearchPage(query: query, page: page, showArchived: showArchived),
    ),
    SetupRoute() => generatedPage(
      key: key,
      location: route.location,
      name: 'setup',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: SetupShell(child: const SetupPage()),
    ),
    SetupConnectRoute() => generatedPage(
      key: key,
      location: route.location,
      name: 'setupConnect',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: SetupShell(child: const SetupConnectPage()),
    ),
  };
}
