String testRouteLocation(TestRoute route) => route.location;

TestRoute parseTestRoute(Uri uri) {
  final segments = uri.pathSegments;

  if (segments.length == 1 && segments[0] == '404') {
    final route = NotFoundRoute(path: uri.queryParameters['path'] ?? '');
    return withGeneratedRouteUriExtras(route, uri, const {'path'});
  }
  if (segments.length == 1 && segments[0] == 'admin') {
    final route = AdminRoute();
    return withGeneratedRouteUriExtras(route, uri, const <String>{});
  }
  if (segments.length == 1 && segments[0] == 'dashboard') {
    final route = DashboardRoute();
    return withGeneratedRouteUriExtras(route, uri, const <String>{});
  }
  if (
    segments.length == 2 &&
    segments[0] == 'dashboard' &&
    segments[1] == 'orders'
  ) {
    final route = DashboardOrdersRoute();
    return withGeneratedRouteUriExtras(route, uri, const <String>{});
  }
  if (segments.length == 2 && segments[0] == 'invite') {
    final code = segments[1];
    final team = uri.queryParameters['team'];
    final route = InviteRoute(code: code, team: team);
    return withGeneratedRouteUriExtras(route, uri, const <String>{'team'});
  }
  if (segments.length == 4 && segments[0] == 'orgs' && segments[2] == 'projects') {
    final orgId = segments[1];
    final projectId = int.tryParse(segments[3]);
    final tab = uri.queryParameters['tab'];
    if (projectId == null) {
      return _$notFoundRoute(uri);
    }
    final route = OrgProjectRoute(
      orgId: orgId,
      projectId: projectId,
      tab: tab,
    );
    return withGeneratedRouteUriExtras(route, uri, const <String>{'tab'});
  }
  if (segments.length == 1 && segments[0] == 'product-picker') {
    final route = ProductPickerRoute();
    return withGeneratedRouteUriExtras(route, uri, const <String>{});
  }
  if (segments.length == 1 && segments[0] == 'products') {
    final query = uri.queryParameters['query'];
    final page = uri.queryParameters.containsKey('page') ? int.tryParse(uri.queryParameters['page'] ?? '') : 1;
    final showArchived = uri.queryParameters.containsKey('showArchived') ? generatedRouteParseBool(uri.queryParameters['showArchived']) : false;
    if (page == null) {
      return _$notFoundRoute(uri);
    }
    if (showArchived == null) {
      return _$notFoundRoute(uri);
    }
    final route = ProductSearchRoute(
      query: query,
      page: page,
      showArchived: showArchived,
    );
    return withGeneratedRouteUriExtras(route, uri, const <String>{'query', 'page', 'showArchived'});
  }
  if (segments.length == 1 && segments[0] == 'setup') {
    final route = SetupRoute();
    return withGeneratedRouteUriExtras(route, uri, const <String>{});
  }
  if (segments.length == 2 && segments[0] == 'setup' && segments[1] == 'connect') {
    final route = SetupConnectRoute();
    return withGeneratedRouteUriExtras(route, uri, const <String>{});
  }
  return _$notFoundRoute(uri);
}

TestRoute _$notFoundRoute(Uri uri) => NotFoundRoute(path: uri.toString());


