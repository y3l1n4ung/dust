    DashboardRoute() => [
      route,
    ],
    DashboardOrdersRoute() => [
      const DashboardRoute(),
      route,
    ],
    InviteRoute(code: _, team: _) => [
      route,
    ],
    OrgProjectRoute(orgId: _, projectId: _, tab: _) => [
      route,
