      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: ProductSearchPage(query: query, page: page, showArchived: showArchived),
    ),
    TestSetupRoute() => generatedPage(
      key: key,
      location: route.location,
      name: 'setup',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: SetupShell(child: const SetupPage()),
