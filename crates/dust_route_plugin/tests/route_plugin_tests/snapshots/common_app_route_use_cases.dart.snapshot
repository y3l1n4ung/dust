extension TestRouterContext on BuildContext {
  RouterController<TestRoutePath> get _routerController =>
      RouterController.of<TestRoutePath>(this);
  TestRoutesNavigator get navigator => TestRoutesNavigator(_routerController);
}

final class TestRoutesNavigator {
  const TestRoutesNavigator(this._router);

  final RouterController<TestRoutePath> _router;

  TestRouteAction<void> notFound({String path = ''}) =>
      TestRouteAction(_router, TestNotFoundRoute(path: path));

  TestRouteAction<void> admin() => TestRouteAction(_router, TestAdminRoute());

  TestRouteAction<void> dashboard() =>
      TestRouteAction(_router, TestDashboardRoute());

  TestRouteAction<void> dashboardOrders() =>
      TestRouteAction(_router, TestDashboardOrdersRoute());

  TestRouteAction<void> invite({required String code, String? team}) =>
      TestRouteAction(_router, TestInviteRoute(code: code, team: team));

  TestRouteAction<void> orgProject({required String orgId, required int projectId, String? tab}) =>
      TestRouteAction(_router, TestOrgProjectRoute(orgId: orgId, projectId: projectId, tab: tab));

  TestRouteAction<int> productPicker() =>
      TestRouteAction(_router, TestProductPickerRoute());

  TestRouteAction<void> productSearch({String? query, int page = 1, bool showArchived = false}) =>
      TestRouteAction(_router, TestProductSearchRoute(query: query, page: page, showArchived: showArchived));

  TestRouteAction<void> setup() => TestRouteAction(_router, TestSetupRoute());

  TestRouteAction<void> setupConnect() =>
      TestRouteAction(_router, TestSetupConnectRoute());

  bool pop<R>([R? result]) => _router.pop<R>(result);
}

final class TestRouteAction<R> {
  const TestRouteAction(this._router, this.route);

  final RouterController<TestRoutePath> _router;
  final TestRoutePath<R> route;

  void go() => _router.go(route);
  Future<R?> push() => _router.push<R>(route);
  void replace() => _router.replace(route);
}


