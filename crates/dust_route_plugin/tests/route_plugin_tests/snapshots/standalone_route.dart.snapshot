    final route = TestProjectRoute(
      projectId: projectId,
      tab: uri.queryParameters['tab'],
      archived: _$parseBool(uri.queryParameters['archived']),
    );
    return _$withRouteUriExtras(route, uri, const <String>{'tab', 'archived'});
  }
  if (
    segments.length == 3 &&
    segments[0] == 'projects' &&
    segments[2] == 'settings'
  ) {
    final projectId = int.tryParse(segments[1]);
    if (projectId == null) {
      return _$notFoundRoute(uri);
    }
    final route = TestProjectSettingsRoute(projectId: projectId);
    return _$withRouteUriExtras(route, uri, const <String>{});
  }
