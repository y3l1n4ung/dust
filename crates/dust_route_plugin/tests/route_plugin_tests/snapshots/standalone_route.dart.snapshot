String testRouteLocation(TestRoute route) => route.location;

TestRoute parseTestRoute(Uri uri) {
  final segments = uri.pathSegments;

  if (segments.isEmpty) {
    final route = DashboardRoute();
    return withGeneratedRouteUriExtras(route, uri, const <String>{});
  }
  if (segments.length == 1 && segments[0] == '404') {
    final route = NotFoundRoute(path: uri.queryParameters['path'] ?? '');
    return withGeneratedRouteUriExtras(route, uri, const {'path'});
  }
  if (segments.length == 2 && segments[0] == 'projects') {
    final projectId = int.tryParse(segments[1]);
    final tab = uri.queryParameters['tab'];
    final archived = uri.queryParameters.containsKey('archived') ? generatedRouteParseBool(uri.queryParameters['archived']) : null;
    if (projectId == null) {
      return _$notFoundRoute(uri);
    }
    if (uri.queryParameters.containsKey('archived') && archived == null) {
      return _$notFoundRoute(uri);
    }
    final route = ProjectRoute(
      projectId: projectId,
      tab: tab,
      archived: archived,
    );
    return withGeneratedRouteUriExtras(route, uri, const <String>{'tab', 'archived'});
  }
  if (
    segments.length == 3 &&
    segments[0] == 'projects' &&
    segments[2] == 'settings'
  ) {
    final projectId = int.tryParse(segments[1]);
    if (projectId == null) {
      return _$notFoundRoute(uri);
    }
    final route = ProjectSettingsRoute(projectId: projectId);
    return withGeneratedRouteUriExtras(route, uri, const <String>{});
  }
  return _$notFoundRoute(uri);
}

TestRoute _$notFoundRoute(Uri uri) => NotFoundRoute(path: uri.toString());


