}

const Map<Type, Type?> _$appliedShellsByPage = {
  DashboardPage: null,
  NotFoundPage: null,
  ProjectPage: AppShell,
  ProjectSettingsPage: AppShell,
};

Page<dynamic> buildTestRoutePage(
  TestRoutePath route,
  LocalKey key,
  PopInvokedWithResultCallback<Object?> onPopInvoked,
) {
  assert(
    generatedRouteShellsMatch($testRoutes, _$appliedShellsByPage),
    'Shell mismatch between \$testRoutes and buildTestRoutePage',
  );
  return switch (route) {
    TestDashboardRoute() => generatedPage(
      key: key,
      location: route.location,
      name: 'dashboard',
      onPopInvoked: onPopInvoked,
      transition: FadeUpwardsPageTransitionsBuilder(),
      fullscreenDialog: false,
      maintainState: true,
      child: const DashboardPage(),
    ),
    TestNotFoundRoute(path: final path) => generatedPage(
      key: key,
      location: route.location,
      name: 'notFound',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: NotFoundPage(path: path),
    ),
    TestProjectRoute(
      projectId: final projectId,
      tab: final tab,
      archived: final archived,
    ) => generatedPage(
      key: key,
      location: route.location,
      name: 'project',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: AppShell(child: ProjectPage(projectId: projectId, tab: tab, archived: archived)),
    ),
    TestProjectSettingsRoute(projectId: final projectId) => generatedPage(
      key: key,
      location: route.location,
      name: 'projectSettings',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: AppShell(child: ProjectSettingsPage(projectId: projectId)),
    ),
  };
