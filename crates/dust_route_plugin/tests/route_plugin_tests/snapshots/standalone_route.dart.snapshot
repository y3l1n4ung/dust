RouteStack<TestRoutePath> restoreTestRouteStack(TestRoutePath route) {
  return switch (route) {
    TestDashboardRoute() => [
      route,
    ],
    TestNotFoundRoute(path: _) => [
      const TestDashboardRoute(),
      route,
    ],
    TestProjectRoute(projectId: _, tab: _, archived: _) => [
      const TestDashboardRoute(),
      route,
    ],
    TestProjectSettingsRoute(projectId: final projectId) => [
      const TestDashboardRoute(),
      TestProjectRoute(projectId: projectId),
      route,
    ],
