      TestRouteAction(_router, TestProjectRoute(projectId: projectId, tab: tab, archived: archived));

  TestRouteAction<void> projectSettings({required int projectId}) =>
      TestRouteAction(_router, TestProjectSettingsRoute(projectId: projectId));

