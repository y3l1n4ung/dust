    if (featured != false) {
      query['featured'] = featured.toString();
    }
    query['from'] = from.toIso8601String();
    if (redirect != null) {
      query['redirect'] = redirect!.toString();
    }
    query['tags'] = tags;
    if (ids != null) {
      query['ids'] = ids!.map((value) => value.toString()).toList(growable: false);
    }
    query['tab'] = tab.name;
