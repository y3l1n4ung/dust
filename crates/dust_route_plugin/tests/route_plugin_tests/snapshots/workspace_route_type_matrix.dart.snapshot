String testRouteLocation(TestRoute route) => route.location;

TestRoute parseTestRoute(Uri uri) {
  final segments = uri.pathSegments;

  if (segments.length == 1 && segments[0] == '404') {
    final route = NotFoundRoute(path: uri.queryParameters['path'] ?? '');
    return withGeneratedRouteUriExtras(route, uri, const {'path'});
  }
  if (segments.length == 2 && segments[0] == 'filters') {
    final code = segments[1];
    final team = uri.queryParameters['team'];
    final minRating = uri.queryParameters.containsKey('minRating') ? double.tryParse(uri.queryParameters['minRating'] ?? '') : null;
    final featured = uri.queryParameters.containsKey('featured') ? generatedRouteParseBool(uri.queryParameters['featured']) : false;
    final from = DateTime.tryParse(uri.queryParameters['from'] ?? '');
    final redirect = uri.queryParameters.containsKey('redirect') ? Uri.tryParse(uri.queryParameters['redirect'] ?? '') : null;
    final tags = uri.queryParametersAll['tags'];
    final ids = uri.queryParametersAll.containsKey('ids') ? generatedRouteParseIntList(uri.queryParametersAll['ids']) : null;
    final tab = generatedRouteParseEnum(tabs.RouteTab.values, uri.queryParameters['tab']);
    if (uri.queryParameters.containsKey('minRating') && minRating == null) {
      return _$notFoundRoute(uri);
    }
    if (featured == null) {
      return _$notFoundRoute(uri);
    }
    if (from == null) {
      return _$notFoundRoute(uri);
    }
    if (uri.queryParameters.containsKey('redirect') && redirect == null) {
      return _$notFoundRoute(uri);
    }
    if (tags == null) {
      return _$notFoundRoute(uri);
    }
    if (uri.queryParametersAll.containsKey('ids') && ids == null) {
      return _$notFoundRoute(uri);
    }
    if (tab == null) {
      return _$notFoundRoute(uri);
    }
    final route = FiltersRoute(
      code: code,
      team: team,
      minRating: minRating,
      featured: featured,
      from: from,
      redirect: redirect,
      tags: tags,
      ids: ids,
      tab: tab,
    );
    return withGeneratedRouteUriExtras(route, uri, const <String>{'team', 'minRating', 'featured', 'from', 'redirect', 'tags', 'ids', 'tab'});
  }
  return _$notFoundRoute(uri);
}

TestRoute _$notFoundRoute(Uri uri) => NotFoundRoute(path: uri.toString());


