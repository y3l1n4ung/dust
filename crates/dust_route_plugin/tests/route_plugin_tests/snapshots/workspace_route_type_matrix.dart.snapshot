final class FiltersRoute extends TestRoute<void> {
  const FiltersRoute({required this.code, this.team, this.minRating, this.featured = false, required this.from, this.redirect, required this.tags, this.ids, required this.tab});

  final String code;
  final String? team;
  final double? minRating;
  final bool featured;
  final DateTime from;
  final Uri? redirect;
  final List<String> tags;
  final List<int>? ids;
  final tabs.RouteTab tab;

  @override
