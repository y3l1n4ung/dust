    TestShopRoute() => generatedPage(
      key: key,
      location: route.location,
      name: 'shop',
      onPopInvoked: onPopInvoked,
      fullscreenDialog: false,
      maintainState: true,
      child: ShopShell(child: const ShopPage()),
