RouteStack<TestRoutePath> restoreTestRouteStack(TestRoutePath route) {
  return switch (route) {
    TestNotFoundRoute(path: _) => [
      route,
    ],
    TestShopRoute() => [
      route,
    ],
    TestCartRoute() => [
      const TestShopRoute(),
      route,
    ],
    TestCheckoutRoute() => [
      const TestShopRoute(),
      route,
    ],
  };
