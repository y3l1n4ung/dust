import 'paths.g.dart';
extension TestRouterContext on BuildContext {
  RouterController<TestRoutePath> get _routerController =>
      RouterController.of<TestRoutePath>(this);
  TestRoutesNavigator get navigator => TestRoutesNavigator(_routerController);
}

final class TestRoutesNavigator {
  const TestRoutesNavigator(this._router);

  final RouterController<TestRoutePath> _router;

  TestRouteAction<void> notFound({String path = ''}) =>
      TestRouteAction(_router, TestNotFoundRoute(path: path));

  TestRouteAction<void> shop() => TestRouteAction(_router, TestShopRoute());

  TestRouteAction<void> cart() => TestRouteAction(_router, TestCartRoute());

  TestRouteAction<bool> checkout() =>
      TestRouteAction(_router, TestCheckoutRoute());

  bool pop<R>([R? result]) => _router.pop<R>(result);
}

final class TestRouteAction<R> {
  const TestRouteAction(this._router, this.route);

  final RouterController<TestRoutePath> _router;
  final TestRoutePath<R> route;

  void go() => _router.go(route);
  Future<R?> push() => _router.push<R>(route);
  void replace() => _router.replace(route);
}


