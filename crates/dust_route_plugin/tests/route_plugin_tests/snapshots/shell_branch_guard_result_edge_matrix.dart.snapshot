const List<GeneratedRoute> $testRoutes = [
  GeneratedRoute(
    '/404',
    page: NotFoundPage,
    name: 'notFound',
    resultType: 'void',
    guards: [],
  ),
  GeneratedRoute(
    '/shop',
    page: ShopPage,
    name: 'shop',
    resultType: 'void',
    shell: ShopShell,
    branch: testBranchShopTabs,
    routes: [
