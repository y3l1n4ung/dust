];

bool testRouteRequiresAuth(TestRoute route) => route.requiresAuth;

String? testRouteBranch(TestRoute route) {
  return switch (route) {
    ShopRoute() => testBranchShopTabs,
    CartRoute() => testBranchShopTabs,
    CheckoutRoute() => testBranchShopTabs,
    _ => null,
