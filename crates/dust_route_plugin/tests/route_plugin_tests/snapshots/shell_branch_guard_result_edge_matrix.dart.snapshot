        'checkout',
        page: CheckoutPage,
        name: 'checkout',
        resultType: 'bool',
        shell: ShopShell,
        branch: testBranchShopTabs,
        guards: [CartGuard],
        fullscreenDialog: true,
      ),
    ],
  ),
];

bool testRouteRequiresAuth(TestRoutePath route) => route.requiresAuth;

String? testRouteBranch(TestRoutePath route) {
  return switch (route) {
    TestShopRoute() => testBranchShopTabs,
    TestCartRoute() => testBranchShopTabs,
    TestCheckoutRoute() => testBranchShopTabs,
    _ => null,
  };
}

RouteDebugInfo testRouteDebugInfo(TestRoutePath route) {
  return switch (route) {
    TestNotFoundRoute(path: _) => const RouteDebugInfo(name: 'notFound', shell: null, branch: null, resultType: 'void'),
    TestShopRoute() => const RouteDebugInfo(name: 'shop', shell: 'ShopShell', branch: testBranchShopTabs, resultType: 'void'),
    TestCartRoute() => const RouteDebugInfo(name: 'cart', shell: 'ShopShell', branch: testBranchShopTabs, resultType: 'void'),
    TestCheckoutRoute() => const RouteDebugInfo(name: 'checkout', shell: 'ShopShell', branch: testBranchShopTabs, resultType: 'bool'),
  };
}

List<RouteGuardBase<TestRoutePath>> testRouteGuards(
  TestRoutePath route,
  Object router,
) {
  return switch (route) {
    TestCartRoute() => [CartGuard()],
    TestCheckoutRoute() => [CartGuard()],
    _ => const [],
  };
}


